{
  "name": "streamyfin",
  "main": "./index",
  "version": "1.0.0",
  "scripts": {
    "submodule-reload": "git submodule update --init --remote --recursive",
    "clean": "echo y | expo prebuild --clean",
    "start": "bun run submodule-reload && expo start",
    "prebuild": "cross-env EXPO_TV=0 bun run clean",
    "prebuild:tv": "cross-env EXPO_TV=1 bun run clean",
    "ios:install-metal-toolchain": "bash scripts/ios/install-metal-toolchain.sh",
    "ios": "cross-env EXPO_TV=0 expo run:ios",
    "ios:tv": "cross-env EXPO_TV=1 expo run:ios",
    "android": "cross-env EXPO_TV=0 expo run:android",
    "android:tv": "cross-env EXPO_TV=1 expo run:android",
    "build:android:local": "cd android && cross-env NODE_ENV=production ./gradlew assembleRelease",
    "ios:unsigned-build": "cross-env EXPO_TV=0 bun scripts/ios/build-ios.ts --production",
    "ios:unsigned-build:tv": "cross-env EXPO_TV=1 bun scripts/ios/build-ios.ts --production",
    "prepare": "husky",
    "typecheck": "bun scripts/typecheck.ts",
    "check": "biome check . --max-diagnostics 1000",
    "lint": "biome check --write --unsafe --max-diagnostics 1000",
    "format": "biome format --write .",
    "doctor": "expo-doctor",
    "i18n:check": "bun scripts/check-i18n-keys.ts",
    "i18n:fix-unused": "bun scripts/check-i18n-keys.ts --fix-unused",
    "test:unit": "bun test",
    "test": "bun run typecheck && bun run test:unit && bun run lint && bun run format && bun run i18n:check && bun run doctor"
  },
  "overrides": {
    "uuid": "14.0.2"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "1.4.0",
    "@douglowder/expo-av-route-picker-view": "^0.0.5",
    "@expo/metro-runtime": "~57.0.6",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/ui": "57.0.10",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "5.2.14",
    "@jellyfin/sdk": "^0.13.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/material-top-tabs": "7.6.16",
    "@react-navigation/native": "7.3.17",
    "@sentry/react-native": "^8.23.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-sync-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "axios": "1.18.1",
    "eventemitter3": "^5.0.4",
    "expo": "57.0.7",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-background-task": "~57.0.5",
    "expo-blur": "~57.0.2",
    "expo-brightness": "~57.0.1",
    "expo-build-properties": "~57.0.6",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-key-event": "^1.9.0",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.5",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-symbols": "~57.0.1",
    "expo-task-manager": "~57.0.5",
    "expo-web-browser": "~57.0.1",
    "i18next": "26.3.6",
    "jotai": "2.20.2",
    "lodash": "4.18.1",
    "nativewind": "^2.0.11",
    "react": "19.2.3",
    "react-i18next": "17.0.11",
    "react-native": "npm:react-native-tvos@0.86.0-2",
    "react-native-awesome-slider": "^2.9.0",
    "react-native-bottom-tabs": "1.4.0",
    "react-native-circular-progress": "^1.4.1",
    "react-native-collapsible": "^1.6.2",
    "react-native-country-flag": "^2.0.2",
    "react-native-device-info": "^15.0.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-image-colors": "2.6.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-pager-view": "8.0.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.3",
    "react-native-reanimated-carousel": "4.0.3",
    "react-native-safe-area-context": "5.8.1",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-tab-view": "4.3.2",
    "react-native-text-ticker": "1.16.0",
    "react-native-track-player": "github:lovegaoshi/react-native-track-player#APM",
    "react-native-udp": "^4.1.7",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-volume-manager": "^2.0.8",
    "react-native-worklets": "0.11.4",
    "sonner-native": "0.26.4",
    "tailwindcss": "3.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.11",
    "@react-native-community/cli": "20.2.0",
    "@react-native-tvos/config-tv": "0.1.6",
    "@types/bun": "1.4.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "axios-mock-adapter": "2.1.0",
    "cross-env": "10.1.0",
    "expo-doctor": "1.20.1",
    "husky": "9.1.7",
    "ignore": "^5.3.2",
    "lint-staged": "17.3.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-google-cast",
          "react-native-udp",
          "react-native-track-player",
          "@jellyfin/sdk"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "react-native",
        "react-native-screens",
        "react-native-reanimated",
        "react-native-worklets",
        "@shopify/flash-list",
        "react-native-pager-view",
        "react-native-safe-area-context",
        "react-native-svg"
      ]
    }
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --unsafe --no-errors-on-unmatched"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "trustedDependencies": [
    "@sentry/cli",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "react-native-udp@4.1.7": "patches/react-native-udp@4.1.7.patch"
  }
}
