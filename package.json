    "start": "bun run submodule-reload && expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "bun run clean",
    "build:android:local": "cd android && cross-env NODE_ENV=production ./gradlew assembleRelease",
