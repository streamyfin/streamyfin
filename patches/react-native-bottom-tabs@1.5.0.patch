+  /// The children that render a tab: those of `filteredItems`, taken from it rather than from a
+  /// copy of its rule, since the tab bar's items are matched to `filteredItems` by position.
+  ///
+  /// A hidden tab is left out of the `ForEach` instead of rendering nothing there: SwiftUI evicts a
+  /// `ForEach` element that no tab retains, and a selection made by the tvOS focus engine walks the
+  /// list outside a view update, where rebuilding that element traps.
+  var renderedChildren: [IdentifiablePlatformView] {
+    let rendered = Set(filteredItems.map(\.key))
+    return children.enumerated().compactMap { index, child in
+      guard let key = items[safe: index]?.key, rendered.contains(key) else {
+        return nil
+      }
