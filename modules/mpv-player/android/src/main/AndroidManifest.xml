<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for network streaming -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background playback: Android 17 mutes an app that is neither visible
         nor running a foreground service, so a video keeps playing with the
         screen off only through PlaybackService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Picture-in-Picture feature -->
    <uses-feature
        android:name="android.software.picture_in_picture"
        android:required="false" />

    <application>
        <service
            android:name="expo.modules.mpvplayer.playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The Cast SDK reads its options from this provider at first use; merged into the app manifest by Gradle. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="expo.modules.mpvplayer.cast.CastOptionsProvider" />

        <!-- The Cast notification's target: brings the app to the front and asks JS for the remote player. In a task of
             its own: the SDK starts it with CLEAR_TASK (TaskStackBuilder), which would empty the app's task. -->
        <activity
            android:name="expo.modules.mpvplayer.cast.RemotePlayerLaunchActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="false" />
    </application>
</manifest>
