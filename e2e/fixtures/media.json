{
  "version": 1,
  "notes": "Cases of the beta's test library used by the playback matrix. `match.code` is the lab tag, `match.channel` a Live TV channel name, `match.audioContainer` the container of a music track. `expect` is the play method expected per target kind; a mismatch is reported, never hidden.",
  "cases": [
    {
      "id": "V01",
      "kind": "video",
      "match": { "code": "V01" },
      "note": "H.264 High 8 bits 1080p, AAC stereo, MKV",
      "expect": {
        "chromecast-gen3": "DirectPlay",
        "google-tv-streamer": "DirectPlay",
        "apple-tv": "DirectPlay"
      }
    },
