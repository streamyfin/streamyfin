            "IsMuted": false,
            "IsPaused": false,
            "ItemId": "item-1",
            "MediaSourceId": "ms-1",
            "PlayMethod": "Transcode",
            "PlaySessionId": "ps-1",
            "PositionTicks": 754621337.6,
            "RepeatMode": "RepeatAll",
            "SubtitleStreamIndex": 3,
            "VolumeLevel": 40
          },
          "NowPlayingItem": {
            "Id": "item-1",
            "RunTimeTicks": 60000000000
          }
