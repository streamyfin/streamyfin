{
  "version": 1,
  "cases": [
    {
      "name": "playback start carries the reporting data as a nested object, the position under PlayState",
      "input": {
        "data": {
          "PlayState": {
            "AudioStreamIndex": 1,
            "CanSeek": true,
            "IsMuted": false,
            "IsPaused": false,
            "ItemId": "item-1",
            "MediaSourceId": "ms-1",
            "PlayMethod": "Transcode",
            "PlaySessionId": "ps-1",
            "PositionTicks": 150000000,
            "RepeatMode": "RepeatNone",
            "SubtitleStreamIndex": 3,
            "VolumeLevel": 0
          },
          "NowPlayingItem": {
            "Id": "item-1",
            "RunTimeTicks": 60000000000
          }
        },
        "type": "playbackstart"
      },
      "expected": {
        "data": {
          "PlayState": {
            "AudioStreamIndex": 1,
            "CanSeek": true,
            "IsMuted": false,
            "IsPaused": false,
            "ItemId": "item-1",
            "MediaSourceId": "ms-1",
            "PlayMethod": "Transcode",
            "PlaySessionId": "ps-1",
            "PositionTicks": 150000000,
            "RepeatMode": "RepeatNone",
            "SubtitleStreamIndex": 3,
            "VolumeLevel": 0
          },
          "NowPlayingItem": {
            "Id": "item-1",
            "RunTimeTicks": 60000000000
          }
        },
        "type": "playbackstart"
      }
    },
    {
      "name": "a progress report arrives from the native bridges as one JSON string, its data nested in it, not encoded twice",
      "input": "{\"data\":{\"PlayState\":{\"AudioStreamIndex\":1,\"CanSeek\":true,\"IsMuted\":false,\"IsPaused\":false,\"ItemId\":\"item-1\",\"MediaSourceId\":\"ms-1\",\"PlayMethod\":\"Transcode\",\"PlaySessionId\":\"ps-1\",\"PositionTicks\":200000000,\"RepeatMode\":\"RepeatNone\",\"SubtitleStreamIndex\":3,\"VolumeLevel\":0},\"NowPlayingItem\":{\"Id\":\"item-1\",\"RunTimeTicks\":60000000000}},\"type\":\"playbackprogress\"}",
      "expected": {
        "data": {
          "PlayState": {
            "AudioStreamIndex": 1,
            "CanSeek": true,
            "IsMuted": false,
            "IsPaused": false,
            "ItemId": "item-1",
            "MediaSourceId": "ms-1",
            "PlayMethod": "Transcode",
            "PlaySessionId": "ps-1",
            "PositionTicks": 200000000,
            "RepeatMode": "RepeatNone",
            "SubtitleStreamIndex": 3,
            "VolumeLevel": 0
          },
          "NowPlayingItem": {
            "Id": "item-1",
            "RunTimeTicks": 60000000000
          }
        },
        "type": "playbackprogress"
      }
    },
    {
