      "input": {
        "data": {
          "PlayState": {
            "AudioStreamIndex": 1,
            "CanSeek": true,
            "IsMuted": false,
            "IsPaused": true,
            "ItemId": "item-1",
            "MediaSourceId": "ms-1",
            "PlayMethod": "Transcode",
            "PlaySessionId": "ps-1",
            "PositionTicks": 250000000,
            "RepeatMode": "RepeatNone",
            "SubtitleStreamIndex": 3,
            "VolumeLevel": 0
          },
          "NowPlayingItem": {
            "Id": "item-1",
            "RunTimeTicks": 60000000000
          }
        },
        "type": "playstatechange"
      },
      "expected": {
        "data": {
          "PlayState": {
            "AudioStreamIndex": 1,
            "CanSeek": true,
            "IsMuted": false,
            "IsPaused": true,
            "ItemId": "item-1",
            "MediaSourceId": "ms-1",
            "PlayMethod": "Transcode",
            "PlaySessionId": "ps-1",
            "PositionTicks": 250000000,
            "RepeatMode": "RepeatNone",
            "SubtitleStreamIndex": 3,
            "VolumeLevel": 0
          },
          "NowPlayingItem": {
            "Id": "item-1",
            "RunTimeTicks": 60000000000
          }
        },
        "type": "playstatechange"
      }
    },
