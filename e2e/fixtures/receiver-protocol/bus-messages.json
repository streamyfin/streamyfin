      "expected": {
        "data": {
          "PlayState": {
            "AudioStreamIndex": 1,
            "CanSeek": true,
            "IsMuted": false,
            "IsPaused": false,
            "ItemId": "item-1",
            "MediaSourceId": "ms-1",
            "PlayMethod": "Transcode",
            "PlaySessionId": "ps-1",
            "PositionTicks": 754621337.6,
            "RepeatMode": "RepeatAll",
            "SubtitleStreamIndex": 3,
            "VolumeLevel": 40
