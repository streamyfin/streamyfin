      }
    },
    {
      "name": "a connection error, its PlaybackInfo request failing, has an empty message",
      "input": {
        "message": "",
        "type": "connectionerror"
      },
      "expected": {
        "message": "",
        "type": "connectionerror"
      }
    },
    {
      "name": "a playback error carries the PlaybackInfo error code: NotAllowed, NoCompatibleStream or RateLimitExceeded",
      "input": {
        "message": "NoCompatibleStream",
        "type": "playbackerror"
      },
      "expected": {
        "message": "NoCompatibleStream",
        "type": "playbackerror"
      }
    },
    {
      "name": "a rejected message is an error with the receiver's fixed text",
      "input": {
        "message": "Missing one or more required params - command,options,userId,accessToken,serverAddress",
        "type": "error"
      },
      "expected": {
        "message": "Missing one or more required params - command,options,userId,accessToken,serverAddress",
        "type": "error"
      }
    },
    {
      "name": "something that is not JSON is passed on unparsed",
      "input": "not json at all",
      "expected": {
        "invalid": true
      }
    },
    {
      "name": "an unquoted name and value are not JSON, though a lenient parser takes it",
      "input": "{type:error}",
      "expected": { "invalid": true }
    },
    {
      "name": "single quotes are not JSON, though a lenient parser takes it",
      "input": "{'type':'error'}",
      "expected": { "invalid": true }
    },
    {
      "name": "a comment after the object is not JSON, though a lenient parser takes it",
      "input": "{\"type\":\"error\"}//c",
      "expected": { "invalid": true }
    },
    {
      "name": "text after the object is not JSON, though a lenient parser takes it",
      "input": "{\"type\":\"error\"} trailing",
      "expected": { "invalid": true }
    }
  ]
}
