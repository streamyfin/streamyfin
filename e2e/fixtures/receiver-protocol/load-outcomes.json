{
  "version": 1,
  "timeoutMs": 30000,
  "request": {
    "items": [{ "Id": "item-1", "Name": "A film", "Type": "Movie" }]
  },
  "cases": [
    {
      "name": "loaded once the receiver plays the item under a new play session",
      "previous": { "itemId": "item-1", "playSessionId": "ps-0" },
      "events": [
        {
          "status": {
            "itemId": "item-1",
            "playSessionId": "ps-1",
            "playerState": "playing"
          }
        }
      ],
      "expected": { "status": "loaded" }
    },
    {
      "name": "the media being replaced does not count as the new load",
      "previous": { "itemId": "item-1", "playSessionId": "ps-0" },
      "events": [
        {
          "status": {
            "itemId": "item-1",
            "playSessionId": "ps-0",
            "playerState": "playing"
          }
        },
        {
          "status": {
            "itemId": "item-1",
            "playSessionId": "ps-1",
            "playerState": "buffering"
          }
        }
      ],
      "expected": { "status": "loaded" }
    },
    {
      "name": "another item playing is not this load",
      "previous": null,
      "events": [
        {
          "status": {
            "itemId": "item-9",
            "playSessionId": "ps-1",
            "playerState": "playing"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "timed_out" }
    },
    {
      "name": "an idle status does not count",
      "previous": null,
      "events": [
        {
          "status": {
            "itemId": "item-1",
            "playSessionId": "ps-1",
            "playerState": "idle"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "timed_out" }
    },
    {
      "name": "a playlist sent first plays one of its entries: a new play session playing counts, whatever its item",
      "request": {
        "items": [
          {
            "Id": "playlist-1",
            "Name": "Road trip",
            "Type": "Playlist"
          }
        ]
      },
      "previous": { "itemId": "item-9", "playSessionId": "ps-0" },
      "events": [
        {
          "status": {
            "itemId": "track-4",
            "playSessionId": "ps-1",
            "playerState": "playing"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "loaded" }
    },
    {
      "name": "an artist sent first plays one of its tracks",
      "request": {
        "items": [
          {
            "Id": "artist-1",
            "Name": "An artist",
            "Type": "MusicArtist"
          }
        ]
      },
      "previous": null,
      "events": [
        {
          "status": {
            "itemId": "track-1",
            "playSessionId": "ps-1",
            "playerState": "playing"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "loaded" }
    },
    {
      "name": "a genre sent first plays one of its tracks",
      "request": {
        "items": [
          {
            "Id": "genre-1",
            "Name": "Jazz",
            "Type": "MusicGenre"
          }
        ]
      },
      "previous": null,
      "events": [
        {
          "status": {
            "itemId": "track-2",
            "playSessionId": "ps-1",
            "playerState": "playing"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "loaded" }
    },
    {
      "name": "a folder sent first, an album here, plays one of the media under it",
      "request": {
        "items": [
          {
            "Id": "album-1",
            "Name": "An album",
            "Type": "MusicAlbum",
            "IsFolder": true
          }
        ]
      },
      "previous": null,
      "events": [
        {
          "status": {
            "itemId": "track-3",
            "playSessionId": "ps-1",
            "playerState": "playing"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "loaded" }
    },
    {
      "name": "a playlist's entry still playing under the play session it had before is not the load",
      "request": {
        "items": [
          {
            "Id": "playlist-1",
            "Name": "Road trip",
            "Type": "Playlist"
          }
        ]
      },
      "previous": { "itemId": "track-4", "playSessionId": "ps-0" },
      "events": [
        {
          "status": {
            "itemId": "track-4",
            "playSessionId": "ps-0",
            "playerState": "playing"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "timed_out" }
    },
    {
      "name": "a playlist's entry that only buffers has not loaded yet",
      "request": {
        "items": [
          {
            "Id": "playlist-1",
            "Name": "Road trip",
            "Type": "Playlist"
          }
        ]
      },
      "previous": null,
      "events": [
        {
          "status": {
            "itemId": "track-4",
            "playSessionId": "ps-1",
            "playerState": "buffering"
          }
        },
        { "timeout": true }
      ],
      "expected": { "status": "timed_out" }
    },
    {
      "name": "a playback error fails the load",
      "previous": null,
      "events": [
        {
          "message": {
            "message": "NotAllowed",
            "type": "playbackerror"
          }
        }
      ],
      "expected": { "status": "failed", "error": "playback_failed" }
    },
    {
      "name": "a failed PlaybackInfo request is a connection error then NoCompatibleStream, and the load fails on the first",
      "previous": null,
      "events": [
        { "message": { "message": "", "type": "connectionerror" } },
        {
          "message": {
            "message": "NoCompatibleStream",
            "type": "playbackerror"
          }
        }
      ],
      "expected": { "status": "failed", "error": "playback_info_failed" }
    },
    {
      "name": "a rejected message fails the load as rejected",
      "previous": null,
      "events": [
        {
          "message": {
            "message": "Missing one or more required params - command,options,userId,accessToken,serverAddress",
            "type": "error"
          }
        }
      ],
      "expected": { "status": "failed", "error": "rejected" }
    },
    {
      "name": "a newer cast supersedes this one",
      "previous": null,
      "events": [{ "supersede": true }],
      "expected": { "status": "superseded" }
    },
    {
      "name": "a receiver that cannot reach the server says nothing, so the load times out",
      "previous": null,
      "events": [{ "timeout": true }],
      "expected": { "status": "timed_out" }
    }
  ]
}
