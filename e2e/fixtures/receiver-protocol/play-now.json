{
  "version": 1,
  "cases": [
    {
      "name": "movie with every option",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV",
        "maxBitrate": 8000000
      },
      "command": "PlayNow",
      "request": {
        "items": [
          {
            "Id": "item-1",
            "Name": "A film",
            "Type": "Movie",
            "MediaType": "Video",
            "IsFolder": false,
            "Overview": "dropped by the sender",
            "RunTimeTicks": 60000000000
          }
        ],
        "startIndex": 0,
        "startPositionTicks": 150000000,
        "mediaSourceId": "ms-1",
        "audioStreamIndex": 1,
        "subtitleStreamIndex": 3
      },
      "expected": {
        "command": "PlayNow",
        "serverAddress": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV",
        "maxBitrate": 8000000,
        "options": {
          "startIndex": 0,
          "startPositionTicks": 150000000,
          "mediaSourceId": "ms-1",
          "audioStreamIndex": 1,
          "subtitleStreamIndex": 3,
          "items": [
            {
              "Id": "item-1",
              "Name": "A film",
              "Type": "Movie",
              "MediaType": "Video",
              "IsFolder": false
            }
          ]
        }
      }
    },
    {
      "name": "no bitrate picked sends the uncapped one, which lifts a cap the receiver kept from an earlier message",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1"
      },
      "command": "PlayNow",
      "request": {
        "items": [
          {
            "Id": "item-2",
            "Name": "Episode",
            "Type": "Episode",
            "MediaType": "Video"
          }
        ]
      },
      "expected": {
        "command": "PlayNow",
        "serverAddress": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "maxBitrate": 120000000,
        "options": {
          "items": [
            {
              "Id": "item-2",
              "Name": "Episode",
              "Type": "Episode",
              "MediaType": "Video",
              "IsFolder": false
            }
          ]
        }
      }
    },
    {
      "name": "a guide program plays its channel live",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV"
      },
      "command": "PlayNow",
      "request": {
        "items": [
          {
            "Id": "program-1",
            "Name": "Evening news",
            "Type": "Program",
            "ChannelId": "channel-1",
            "ChannelName": "1 Films libres"
          }
        ],
        "startPositionTicks": 150000000
      },
      "expected": {
        "command": "PlayNow",
        "serverAddress": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV",
        "maxBitrate": 120000000,
        "options": {
          "items": [
            {
              "Id": "channel-1",
              "Name": "1 Films libres",
              "Type": "TvChannel",
              "MediaType": "Video",
              "IsFolder": false
            }
          ]
        }
      }
    },
    {
      "name": "a live stream already open goes with its media source, for the receiver's PlaybackInfo",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV"
      },
      "command": "PlayNow",
      "request": {
        "items": [
          {
            "Id": "channel-1",
            "Name": "1 Films libres",
            "Type": "TvChannel",
            "MediaType": "Video"
          }
        ],
        "mediaSourceId": "ms-live-1",
        "liveStreamId": "live-1"
      },
      "expected": {
        "command": "PlayNow",
        "serverAddress": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV",
        "maxBitrate": 120000000,
        "options": {
          "mediaSourceId": "ms-live-1",
          "liveStreamId": "live-1",
          "items": [
            {
              "Id": "channel-1",
              "Name": "1 Films libres",
              "Type": "TvChannel",
              "MediaType": "Video",
              "IsFolder": false
            }
          ]
        }
      }
    },
    {
      "name": "a plain command carries the server and the bitrate cap on every message",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV"
      },
      "command": "Pause",
      "options": {},
      "expected": {
        "command": "Pause",
        "serverAddress": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV",
        "maxBitrate": 120000000,
        "options": {}
      }
    },
    {
      "name": "seek takes its position in seconds, sent whole: the receiver makes ticks of it unrounded, which the server may reject",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1"
      },
      "command": "Seek",
      "options": { "position": 125.6 },
      "expected": {
        "command": "Seek",
        "serverAddress": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "maxBitrate": 120000000,
        "options": { "position": 126 }
      }
    },
    {
      "name": "seek rounds as Math.round does: just under a half goes down, which adding 0.5 first gets wrong",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1"
      },
      "command": "Seek",
      "options": { "position": 0.49999999999999994 },
      "expected": {
        "command": "Seek",
        "serverAddress": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "maxBitrate": 120000000,
        "options": { "position": 0 }
      }
    },
    {
      "name": "a container is refused",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV"
      },
      "command": "PlayNow",
      "request": {
        "items": [
          {
            "Id": "playlist-1",
            "Name": "Road trip",
            "Type": "Playlist",
            "MediaType": "Audio"
          }
        ]
      },
      "expected": { "refused": "container" }
    },
    {
      "name": "a container anywhere in the queue is refused, and any folder is one whatever its type",
      "session": {
        "basePath": "https://jellyfin.example.test",
        "accessToken": "tok-123",
        "userId": "user-1",
        "receiverName": "Living Room TV"
      },
      "command": "PlayNow",
      "request": {
        "items": [
          {
            "Id": "track-1",
            "Name": "A track",
            "Type": "Audio",
            "MediaType": "Audio",
            "IsFolder": false
          },
          {
            "Id": "album-1",
            "Name": "An album",
            "Type": "MusicAlbum",
            "IsFolder": true
          }
        ],
        "startIndex": 0
      },
      "expected": { "refused": "container" }
    }
  ]
}
